{
  "name": "shinobi-identity-archive-v10",
  "private": true,
  "version": "10.5.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "npm run test:regression",
    "test:watch": "vitest",
    "check": "npm run test:regression && npm run build",
    "preflight": "tsx server/preflight.ts",
    "preflight:live": "tsx server/preflight.ts --live",
    "release:check": "npm run check && npm run preflight:artifact",
    "test:unit": "vitest run src/engine/__tests__/quiz.test.ts server/__tests__/security.test.ts server/__tests__/payments-generation.test.ts server/__tests__/generation-failures.test.ts server/__tests__/release-schema.test.ts",
    "test:smoke": "vitest run server/__tests__/api.smoke.test.ts",
    "test:regression": "npm run test:unit && npm run test:smoke",
    "preflight:artifact": "tsx server/preflight.ts --artifact"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "html-to-image": "^1.11.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8",
    "@supabase/supabase-js": "^2.57.4",
    "stripe": "^22.5.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
