# Public Supabase values used by the Vite frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Server-only Supabase values. NEVER prefix the service role key with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key

# Server-only OpenAI image generation
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2

# Server-only Stripe payments
STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Public URL of the deployed app, no trailing slash
APP_URL=http://localhost:5173
PORT=8787

# Optional comma-separated additional browser origins allowed to call protected POST APIs.
# APP_URL is always trusted automatically.
TRUSTED_ORIGINS=

# Optional internal diagnostics endpoint protection.
# When unset, /api/internal/diagnostics behaves as not found.
# Set this to a long random value and send it as X-Diagnostics-Token.
DIAGNOSTICS_TOKEN=

# Release/deployment metadata and startup hardening
# Render provides RENDER_GIT_COMMIT automatically; BUILD_COMMIT is a fallback for other hosts.
BUILD_COMMIT=
BUILD_ID=
BUILD_TIMESTAMP=
RELEASE_CHANNEL=development

# In production this defaults to enabled. Set to false only as an emergency bypass
# if the schema version probe cannot run; normal deployments should keep it enabled.
STARTUP_LIVE_PREFLIGHT=true
